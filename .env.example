# قاعدة بيانات Postgres (تُوفَّر تلقائياً من Railway عند إضافة قاعدة بيانات)
DATABASE_URL=postgresql://user:password@host:port/database

# مفتاح مستقبل من TMDB
TMDB_API_KEY=

# سر التوقيع للجلسات - ولّده بأمر زي:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# العنوان الأساسي لمصدر المشاهدة (مش هتغيّره غالباً)
TOPCINEMA_BASE_URL=https://topcinema.io